public class EnemyAIData
{
  private float x;//敵人X位置
  private float y;//敵人Y位置
  private float speed;//敵人移動速度
  private int enemySize;
  private int health;
  private boolean isAlive;

  // 透過 MobData 初始化實體座標（依地圖網格換算為像素位置）
  public EnemyAIData(MobData mob)
  {
    int gridSize = width / 11;
    this.x = mob.spawnX * gridSize;
    this.y = mob.spawnY * gridSize;
    this.health = mob.health;
    this.speed = 2.0;
    this.enemySize = 40;
    this.isAlive = true;
  }

  // 自訂座標建構子
  public EnemyAIData(float startX, float startY, int initialHealth)
  {
    this.x = startX;
    this.y = startY;
    this.health = initialHealth;
    this.speed = 2.0;
    this.enemySize = 40;
    this.isAlive = true;
  }

  // 自動追蹤玩家的核心邏輯
  public void Update(PlayerMovement player)
  {
    if (!isAlive || player == null) return;

    // 計算與玩家中心點的向量差距
    float targetX = player.getX();
    float targetY = player.getY();
    float dx = targetX - this.x;
    float dy = targetY - this.y;
    float distance = dist(this.x, this.y, targetX, targetY);

    // 當距離大於微小值時朝玩家移動，避免原地抖動
    if (distance > 3)
    {
      this.x += (dx / distance) * speed;
      this.y += (dy / distance) * speed;
    }

    // 限制敵人在視窗邊界內
    this.x = constrain(this.x, 0, width - enemySize);
    this.y = constrain(this.y, 0, height - enemySize);
  }

  // 繪製敵人
  public void Render()
  {
    if (!isAlive) return;

    fill(220, 50, 50); // 敵方代表色（紅色）
    rect(this.x, this.y, enemySize, enemySize);

    // 顯示血量標籤
    fill(255);
    textSize(14);
    text("HP: " + health, this.x, this.y - 5);
  }

  public float getX() { return x; }
  public float getY() { return y; }
  public int getHealth() { return health; }
  public boolean isAlive() { return isAlive; }
  
  public void takeDamage(int amount)//死亡判斷
  {
    health -= amount;
    if (health <= 0)
    {
      isAlive = false;
    }
  }
}
